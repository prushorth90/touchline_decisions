ENVIRONMENT=Development
INSIGHTS_SOURCE=fixture
# S3 mode: set INSIGHTS_SOURCE=s3 and REPORT_BUCKET to the CDK ReportBucketName output.
REPORT_BUCKET=
# Optional: INSIGHTS_FIXTURE_PATH=/absolute/path/to/report.json
AGENT_DIRECTORY=../.github/agents
Cors__AllowedOrigins__0=http://localhost:5173
FplApi__BaseUrl=https://fantasy.premierleague.com/api/
FplApi__RequestTimeoutSeconds=15
FplApi__BootstrapCacheMinutes=60
FplApi__FixturesCacheMinutes=15
FplApi__ManagerCacheMinutes=5
FplApi__SquadCacheMinutes=5
FplApi__PlayerHistoryCacheMinutes=30
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=fpl;Username=fpl;Password=change_me
Persistence__RecommendationSnapshotMinutes=15
Persistence__ApplyMigrations=true
Redis__ConnectionString=localhost:6379
Security__RequestLimitPerMinute=120
Security__MaxRequestBodyKilobytes=64